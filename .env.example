# Google Cloud OAuth credentials
# 从 Google Cloud Console > APIs & Services > Credentials 获取
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Day 1 手工 OAuth 流程的回调地址（scripts/oauth-flow.js 用）
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# 授权后通过 scripts/oauth-flow.js 获取，手动填入 .env.local
# 注意：接入 Supabase 多租户登录后，这里是「单租户兜底凭据」，
# 每个用户自己的 refresh token 存在 Supabase 的 users_tokens 表里。
GOOGLE_REFRESH_TOKEN=

# Supabase（Project Settings > API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# publishable key（sb_publishable_ 开头，可安全暴露到浏览器）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# service_role secret key（sb_secret_ 开头，绕过 RLS）
# ⚠️ 绝不能加 NEXT_PUBLIC_ 前缀，否则会被打包进浏览器代码
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

